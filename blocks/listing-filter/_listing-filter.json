{
  "definitions": [
    {
      "title": "Listing Filter",
      "id": "listing-filter",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block",
            "template": {
              "name": "listing-filter",
              "model": "listing-filter",
              "filter": "only-listing-items"
            }
          }
        }
      }
    },
    {
      "title": "Listing Item",
      "id": "listing-item",
      "plugins": {
        "xwalk": {
          "page": {
            "resourceType": "core/franklin/components/block/v1/block/item",
            "template": {
              "name": "listing-item",
              "model": "listing-item"
            }
          }
        }
      }
    }
  ],
  "models": [
    {
      "id": "listing-filter",
      "fields": [
        {
          "component": "text",
          "name": "sectionTitle",
          "label": "Section Title (Main Heading)",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "allAwardsLabel",
          "label": "All Awards Button Text",
          "valueType": "string",
          "defaultValue": "All Awards"
        },
        {
          "component": "select",
          "name": "viewType",
          "label": "View Type",
          "valueType": "string",
          "options": [
            { "name": "Awards (List View)", "value": "awards" },
            { "name": "Partners (Grid View)", "value": "partners" }
          ],
          "defaultValue": "awards"
        },
        {
          "component": "text",
          "name": "filterPanelTitle",
          "label": "Filter Sidebar Title",
          "valueType": "string",
          "defaultValue": "Filter by Year and Category"
        },
        {
          "component": "text",
          "name": "defaultYear",
          "label": "Initial Year to Show",
          "valueType": "string",
          "defaultValue": "2026"
        }
      ]
    },
    {
      "id": "listing-item",
      "itemLabel": "title",
      "fields": [
        {
          "component": "select",
          "name": "itemType",
          "label": "Item Category",
          "valueType": "string",
          "options": [
            { "name": "Corporate", "value": "corporate" },
            { "name": "Airports & Aero Services", "value": "airports" },
            { "name": "Energy", "value": "energy" },
            { "name": "Sports", "value": "sports" },
            { "name": "Foundation", "value": "foundation" },
            { "name": "Transport & Urban Infrastructure ", "value": "Transport " },
            { "name": "Other Services", "value": "others" }
          ]
        },
        {
          "component": "text",
          "name": "year",
          "label": "Year (e.g. 2026)",
          "valueType": "string"
        },
        {
          "component": "reference",
          "name": "image",
          "label": "Award/Partner Image",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "title",
          "label": "Title / Heading",
          "valueType": "string"
        },
        {
          "component": "richtext",
          "name": "description",
          "label": "Description Text",
          "valueType": "string"
        },
        {
          "component": "text",
          "name": "link",
          "label": "Detail Page URL",
          "valueType": "string"
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "only-listing-items",
      "components": ["listing-item"]
    }
  ]
}
